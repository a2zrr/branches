{
  "name": "branches",
  "version": "1.0.0",
  "description": "Apprends Git en jouant : un vrai terminal, un graphe qui s'anime, une start-up à sauver. 100 % dans le navigateur, sans compte.",
  "keywords": [
    "git",
    "apprendre-git",
    "jeu",
    "education",
    "gamification",
    "react",
    "typescript",
    "vite",
    "zustand"
  ],
  "license": "MIT",
  "author": "Abdel hak EZZERBOUTI (https://github.com/a2zrr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2zrr/branches.git"
  },
  "homepage": "https://github.com/a2zrr/branches#readme",
  "bugs": {
    "url": "https://github.com/a2zrr/branches/issues"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "captures": "CAPTURES=1 playwright test e2e/captures-readme.spec.ts",
    "verif": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "motion": "^14.14.0",
    "node-diff3": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
